#!/usr/bin/env bash
# Gate de commit, independiente del agente (o de si hay agente): corre igual con Claude Code,
# Codex, OpenCode o editando a mano. Se activa con `scripts/setup-agent-harness.sh`.
#
#   1. Bloquea commits que incluyan un .env real (las plantillas .env.example sí pasan).
#   2. Verifica que los archivos generados de agentes/MCP estén al día con `.agents/`.
#   3. ruff check + ruff format --check sobre los .py de backend en stage.
#   4. eslint + prettier --check sobre los .ts/.tsx de frontend en stage.
#
# Saltar en una emergencia: `git commit --no-verify`.
set -u
root=$(git rev-parse --show-toplevel)
main=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
cd "$root" || exit 1
fail=0

staged=$(git diff --cached --name-only --diff-filter=ACMR)

envs=$(printf '%s\n' "$staged" | grep -E '(^|/)(\.env(\..+)?|[^/]+\.env)$' | grep -vE '\.env\.example$')
if [ -n "$envs" ]; then
  echo "✗ pre-commit: no se commitean archivos .env con secretos:" >&2
  printf '    %s\n' $envs >&2
  fail=1
fi

if ! python3 scripts/sync-agents.py --check >&2; then
  echo "✗ pre-commit: config de agentes desactualizada respecto a .agents/" >&2
  fail=1
fi

py=$(printf '%s\n' "$staged" | grep -E '^backend/.*\.py$')
if [ -n "$py" ]; then
  ruff=""
  for r in "$root" "$main"; do [ -x "$r/backend/venv/bin/ruff" ] && { ruff="$r/backend/venv/bin/ruff"; break; }; done
  [ -n "$ruff" ] || ruff=$(command -v ruff || true)
  if [ -z "$ruff" ]; then
    echo "⚠ pre-commit: ruff no encontrado, se omite el lint de backend" >&2
  else
    files=$(printf '%s\n' "$py" | sed 's|^backend/||')
    (cd backend && "$ruff" check $files && "$ruff" format --check $files) >&2 || {
      echo "✗ pre-commit: ruff falló (arreglar con: cd backend && ruff check --fix . && ruff format .)" >&2
      fail=1
    }
  fi
fi

ts=$(printf '%s\n' "$staged" | grep -E '^frontend/.*\.(ts|tsx)$')
if [ -n "$ts" ]; then
  bin="$root/frontend/node_modules/.bin"
  if [ ! -x "$bin/eslint" ]; then
    echo "⚠ pre-commit: frontend/node_modules no instalado en este checkout, se omite el lint de frontend" >&2
  else
    files=$(printf '%s\n' "$ts" | sed 's|^frontend/||')
    (cd frontend && "$bin/eslint" $files && "$bin/prettier" --check $files) >&2 || {
      echo "✗ pre-commit: eslint/prettier falló (arreglar con: cd frontend && pnpm lint && pnpm format)" >&2
      fail=1
    }
  fi
fi

exit $fail
