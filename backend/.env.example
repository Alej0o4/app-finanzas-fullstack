SECRET_KEY=your-secret-key-here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./finanzas.db

# --- Email (Fase 7, §2.1) — todas opcionales ---
# URL base del frontend usada para construir los links de los emails de recuperación de
# contraseña y verificación de email.
FRONTEND_URL=http://localhost:3000

# EMAIL_PROVIDER=console (default si no está seteada): no envía correos de verdad, los
# loguea (destinatario, asunto, link) a nivel INFO — suficiente para desarrollo/pruebas.
EMAIL_PROVIDER=console

# EMAIL_PROVIDER=smtp: envío real vía SMTP genérico. Descomentar y completar si se usa.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USER=usuario@tu-proveedor.com
# SMTP_PASSWORD=changeme
# SMTP_FROM_EMAIL=no-reply@tu-dominio.com
