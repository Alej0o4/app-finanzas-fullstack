{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "small_model": "opencode/north-mini-code-free",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  },
  "permission": {
    "edit": "allow",
    "bash": "allow"
  },
  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "command": {
    "lint-frontend": {
      "template": "Corre el linter del frontend y dime los errores. Si no hay errores, solo di 'Sin errores'.\n\n!`cd frontend && pnpm lint 2>&1`",
      "description": "Lint del frontend con ESLint",
      "subtask": true
    },
    "tech-debt": {
      "template": "Revisa docs/TODO.md y responde qué items de deuda técnica impactan la tarea actual. Si no hay relación, solo di 'Sin impacto'.",
      "description": "Revisa deuda técnica relevante",
      "subtask": true
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium"
      ],
      "enabled": true
    }
  }
}
