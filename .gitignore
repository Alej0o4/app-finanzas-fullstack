# Ignorar entornos virtuales
backend/venv/

# Config local de Claude Code (personal, no compartir con el equipo)
.claude/settings.local.json

# Ignorar archivos compilados temporales de Python
backend/__pycache__/
backend/.coverage
backend/.pytest_cache/
*.pyc

# Ignorar archivo de las variables de entorno
backend/.env
/.env

# Backups locales de la base de datos (scripts/backup.sh)
backups/

# Base de datos SQLite
*.db

# Imágenes de referencia
*.png
# Excepto los íconos de la PWA (Fase 13 §13.1), que manifest.json y sw.js referencian en runtime
!frontend/public/icons/*.png

.vscode/
.idea/
.DS_Store
.playwright-mcp/

# Grafo de conocimiento de graphify - regenerable con `graphify update .`
graphify-out/