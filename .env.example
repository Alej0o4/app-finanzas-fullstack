# Variables de entorno para docker compose (docker-compose.yml / docker-compose.dev.yml).
# Copiar a `.env` en la raíz del repo — Docker Compose lo lee automáticamente.
# Distinto de backend/.env.example, que es para correr el backend sin Docker.
#
# POSTGRES_PASSWORD y SECRET_KEY son obligatorias: si no están seteadas, `docker compose up`
# falla el arranque en vez de continuar con un valor por defecto conocido.

# Contraseña del usuario `oikos` de PostgreSQL. Generar una propia, no reutilizar ejemplos.
POSTGRES_PASSWORD=changeme_generate_a_strong_password

# Clave usada para firmar los JWT. Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_random_secret_key

# Orígenes permitidos por CORS, separados por coma. Tiene un default de desarrollo razonable
# si no se define (ver docker-compose.yml), no es obligatoria.
# ALLOWED_ORIGINS=http://localhost:3000,http://100.76.235.30:3000
