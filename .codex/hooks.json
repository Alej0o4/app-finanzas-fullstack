{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/agent-hooks/guard-env.sh",
            "statusMessage": "Revisando que no se edite un .env"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/agent-hooks/format-file.sh",
            "statusMessage": "Formateando archivos tocados",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
